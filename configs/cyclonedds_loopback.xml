<?xml version="1.0" encoding="UTF-8" ?>
<!-- CycloneDDS transport config for running against unitree_mujoco on loopback.
     The `lo` interface has no MULTICAST flag, so default multicast discovery
     fails. This forces unicast discovery to localhost over `lo`. Use the SAME
     config on BOTH the sim and the client:
         export CYCLONEDDS_URI=file://$PWD/configs/cyclonedds_loopback.xml
     (sim and client must share it, or they won't discover each other). -->
<CycloneDDS xmlns="https://cdds.io/config"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="https://cdds.io/config https://raw.githubusercontent.com/eclipse-cyclonedds/cyclonedds/master/etc/cyclonedds.xsd">
  <Domain id="any">
    <General>
      <Interfaces>
        <NetworkInterface name="lo" presence_required="false"/>
      </Interfaces>
      <AllowMulticast>false</AllowMulticast>
      <EnableMulticastLoopback>true</EnableMulticastLoopback>
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>50</MaxAutoParticipantIndex>
      <Peers>
        <Peer address="localhost"/>
      </Peers>
    </Discovery>
  </Domain>
</CycloneDDS>
